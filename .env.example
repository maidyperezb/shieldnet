# ====================================================================
# INFRAESTRUCTURA (BASE DE DATOS Y SERVIDOR)
# ====================================================================
SERVER_PORT=8080
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shieldnet
MYSQL_USERNAME=root
MYSQL_PASSWORD=tu_password_aqui

# Hibernate: update (desarrollo), validate (producción)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# ====================================================================
# TELEFONÍA (ASTERISK)
# ====================================================================
ASTERISK_HOST=172.29.126.164
ASTERISK_PORT=5038
ASTERISK_USERNAME=admin
ASTERISK_PASSWORD=Admin123

LOGGING_LEVEL_COM_EXAMPLE_SECURITY=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_HIBERNATE=INFO
SERVER_ERROR_INCLUDE_MESSAGE=always
SERVER_ERROR_INCLUDE_BINDING_ERRORS=always

# ====================================================================
# IA - CONFIGURACIÓN DE GROQ
# ====================================================================
# Consigue tu key en https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelos recomendados: openai/gpt-oss-20b (producción) u openai/gpt-oss-120b
# (mayor capacidad). qwen/qwen3-32b y llama-3.1-8b-instant fueron
# decommissioned por Groq en 2026 y devuelven 404 en cada petición.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_CHAT_TEMPERATURE=0.7
GROQ_CHAT_TOP_P=0.95
GROQ_CHAT_MAX_TOKENS=8192
GROQ_CHAT_TIMEOUT=30s

# ====================================================================
# LÓGICA DE NEGOCIO DEL CHAT
# ====================================================================
CHAT_MAX_HISTORY=20
CHAT_CONTEXT_DAYS=7
CHAT_ENABLE_FUNCTION_CALLING=false
CHAT_GROQ_REQUESTS_PER_MINUTE=60

# ====================================================================
# CONFIGURACIÓN DE HERRAMIENTAS (TOOLS)
# ====================================================================
TOOL_EVENT_HISTORY_DAYS_DEFAULT=7
TOOL_EVENT_HISTORY_MAX_RESULTS=100
TOOL_QOS_METRICS_DAYS_DEFAULT=7
TOOL_QOS_METRICS_AGGREGATION_WINDOW=1h
TOOL_NETWORK_SCAN_TIMEOUT_SECONDS=60
TOOL_NETWORK_SCAN_MAX_HOSTS=256
TOOL_NETWORK_SCAN_ALLOWED_TYPES=arp,port
TOOL_DEVICES_CHECK_AUTHORIZATION_BEFORE_ACTION=true
TOOL_REPORT_DAYS_DEFAULT=7
TOOL_REPORT_INCLUDE_CHARTS=true

# ====================================================================
# PERSISTENCIA Y SEGURIDAD DEL CHAT
# ====================================================================
CHAT_DB_RETENTION_DAYS=90
CHAT_DB_AUTO_CLEANUP=true
CHAT_DB_CLEANUP_SCHEDULE=0 0 2 * * ?
CHAT_SESSION_TIMEOUT_MINUTES=30
CHAT_SESSION_MAX_CONCURRENT=10

CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_REQUESTS_PER_MINUTE=30
CHAT_RATE_LIMIT_REQUESTS_PER_HOUR=300

# ====================================================================
# INTERFAZ DE USUARIO (UI)
# ====================================================================
CHAT_WIDGET_AUTO_OPEN=false
CHAT_WIDGET_POSITION=bottom-right
CHAT_WIDGET_WIDTH=400px
CHAT_WIDGET_HEIGHT=600px
CHAT_STREAMING_ENABLED=true